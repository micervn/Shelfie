{
  "name": "Shelfie",
  "short_name": "Shelfie",
  "id": "./",
  "description": "A cozy, offline reader for your ebooks and PDFs.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F0E8DA",
  "theme_color": "#F0E8DA",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "books",
    "education",
    "lifestyle"
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "books",
          "accept": [
            "application/epub+zip",
            "application/pdf",
            "application/x-mobipocket-ebook",
            "application/vnd.amazon.ebook",
            "application/x-fictionbook+xml",
            "application/vnd.comicbook+zip",
            "text/plain",
            "application/zip",
            "application/octet-stream",
            ".epub",
            ".pdf",
            ".mobi",
            ".azw3",
            ".azw",
            ".fb2",
            ".fbz",
            ".cbz",
            ".txt",
            "text/html",
            "application/xhtml+xml",
            ".html",
            ".htm"
          ]
        }
      ]
    }
  }
}